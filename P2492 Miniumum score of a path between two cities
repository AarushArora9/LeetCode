class Solution {
    public int minScore(int n, int[][] roads) {
        int root[]=new int[n+1];
        for(int i=0;i<=n;i++)
        root[i]=i;
        for(int i[]:roads)
        root[find(root,i[0])]=find(root,i[1]);
        int res=10001;
        for(int i[]:roads)
        if(find(root,i[0])==find(root,1))
        res=Math.min(res,i[2]);
        return res;
    }
    int find(int root[],int i)
    {
        if(root[i]==i)
        return i;
        return root[i]=find(root,root[i]);
    }
}
